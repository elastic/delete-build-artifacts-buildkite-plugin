#!/usr/bin/env bash

set -euo pipefail

body_file=""
method="GET"
url=""
write_out=""

while (($# > 0)); do
	case "$1" in
	--output)
		body_file="$2"
		shift 2
		;;
	--request)
		method="$2"
		shift 2
		;;
	--write-out)
		write_out="$2"
		shift 2
		;;
	--header | --connect-timeout | --max-time | --retry | --retry-delay)
		shift 2
		;;
	--silent | --show-error)
		shift
		;;
	*)
		url="$1"
		shift
		;;
	esac
done

printf '%s %s\n' "${method}" "${url}" >>"${FAKE_CURL_LOG}"

if [[ -n "${FAKE_CURL_FAIL_MATCH:-}" && "${url}" == *"${FAKE_CURL_FAIL_MATCH}"* ]]; then
	exit 7
fi

case "${method}" in
GET)
	page="$(printf '%s' "${url}" | sed -n 's/.*[?&]page=\([0-9][0-9]*\).*/\1/p')"
	status_file="${FAKE_CURL_RESPONSES}/page-${page}.status"
	response_file="${FAKE_CURL_RESPONSES}/page-${page}.json"
	status="200"
	[[ -f "${status_file}" ]] && status="$(cat "${status_file}")"
	if [[ -f "${response_file}" ]]; then
		cp "${response_file}" "${body_file}"
	else
		printf '[]\n' >"${body_file}"
	fi
	;;
DELETE)
	status="${FAKE_CURL_DELETE_STATUS:-204}"
	printf '%s' "${FAKE_CURL_DELETE_BODY:-}" >"${body_file}"
	;;
*)
	exit 2
	;;
esac

if [[ -n "${write_out}" ]]; then
	printf '%s' "${status}"
fi
