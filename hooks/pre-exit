#!/usr/bin/env bash

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck disable=SC1091
source "${DIR}/../lib/delete-artifacts.bash"

continue_on_error() {
	local status=$?
	if ((status != 0)); then
		echo "delete-build-artifacts: cleanup failed (exit ${status}); continuing because continue-on-error is enabled" >&2
	fi
	exit 0
}

# An EXIT trap preserves errexit inside the cleanup function.
if [[ "${BUILDKITE_PLUGIN_DELETE_BUILD_ARTIFACTS_CONTINUE_ON_ERROR:-false}" == "true" ]]; then
	trap continue_on_error EXIT
fi

echo "~~~ :wastebasket: Deleting build artifacts"
delete_build_artifacts
